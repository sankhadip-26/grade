
WITH date_range AS (
  SELECT
    DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 90 DAY) AS start_date,
    DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 1 DAY) AS end_date
),

-- =========================================================
-- PART 1: IN-STOCK DRR - ORIGINAL LOGIC
-- =========================================================

sku_in_stock_days AS (
  SELECT
    sku,
    company_code,
    create_date,
    store_code,
    SUM(quantity) AS qty
  FROM `slikk-prod.slikkprodpublic.product_inventorysnapshot`
  CROSS JOIN date_range d
  WHERE
    create_date >= d.start_date
    AND create_date <= d.end_date
  GROUP BY 1, 2, 3, 4
),

drr_sales AS (
  SELECT
    pp.sku AS sku,
    sc.code AS company_code,
    DATE(oo.create_date + INTERVAL 330 MINUTE) AS order_date,
    LOWER(ss.code) AS store_code,
    SUM(oi.quantity) AS qty_ordered
  FROM `slikk-prod.slikkprodpublic.order_order` oo
  JOIN `slikk-prod.slikkprodpublic.order_orderitem` oi
    ON oo.id = oi.order_id
  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = oi.product_id
  JOIN `slikk-prod.slikkprodpublic.store_company` sc
    ON sc.id = pp.company_id
  JOIN `slikk-prod.slikkprodpublic.store_store` ss
    ON ss.id = oo.store_id
  CROSS JOIN date_range d
  WHERE
    oo.delivery_type != 'EXCHANGE'
    AND oo.status NOT IN ('OPEN', 'FAILED')
    AND DATE(oo.create_date + INTERVAL 330 MINUTE)
      BETWEEN d.start_date AND d.end_date
  GROUP BY 1, 2, 3, 4
),

sku_store_days AS (
  SELECT
    COALESCE(s.sku, i.sku) AS sku,
    COALESCE(s.company_code, i.company_code) AS company_code,
    COALESCE(s.order_date, i.create_date) AS day,
    COALESCE(i.qty, 0) AS inv_qty,
    COALESCE(s.qty_ordered, 0) AS sold_qty,
    COALESCE(s.store_code, i.store_code) AS store_code
  FROM drr_sales s
  FULL OUTER JOIN sku_in_stock_days i
    ON s.sku = i.sku
    AND LOWER(s.company_code) = LOWER(i.company_code)
    AND s.order_date = i.create_date
    AND s.store_code = i.store_code
),

store_day_flagged AS (
  SELECT
    sku,
    company_code,
    store_code,
    day,
    inv_qty,
    sold_qty,
    CASE
      WHEN inv_qty > 0 OR sold_qty > 0 THEN 1
      ELSE 0
    END AS active_day_flag
  FROM sku_store_days
),

sku_day AS (
  SELECT
    sku,
    company_code,
    day,
    SUM(sold_qty) AS sold_qty,
    MAX(active_day_flag) AS active_day_flag
  FROM store_day_flagged
  GROUP BY 1, 2, 3
),

sku_drr AS (
  SELECT
    sku,
    company_code,

    SUM(
      IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 30 DAY),
        sold_qty, 0)
    ) AS qty_30d,

    SUM(
      IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 30 DAY),
        active_day_flag, 0)
    ) AS active_days_30d,

    SUM(
      IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 60 DAY),
        sold_qty, 0)
    ) AS qty_60d,

    SUM(
      IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 60 DAY),
        active_day_flag, 0)
    ) AS active_days_60d,

    SUM(sold_qty) AS qty_90d,
    SUM(active_day_flag) AS active_days_90d

  FROM sku_day
  GROUP BY 1, 2
),

sku_drr_final AS (
  SELECT
    sku,
    company_code,

    ROUND(
      SAFE_DIVIDE(qty_30d, active_days_30d)
      * IF(active_days_30d <= 3, 0.5, 1),
      2
    ) AS drr_30d,

    ROUND(
      SAFE_DIVIDE(qty_60d, active_days_60d)
      * IF(active_days_60d <= 3, 0.5, 1),
      2
    ) AS drr_60d,

    ROUND(
      SAFE_DIVIDE(qty_90d, active_days_90d)
      * IF(active_days_90d <= 3, 0.5, 1),
      2
    ) AS drr_90d

  FROM sku_drr
),

-- =========================================================
-- PART 2: SALES - INCLUDING REALIZED GMV
-- =========================================================

sales_base AS (
  SELECT
    UPPER(TRIM(nt.division)) AS division,
    COALESCE(pb.name, 'NA') AS brand,
    nt.gender AS gender,

    pp.sku AS sku,
    pp.variant_id AS style_code,
    sc.code AS company_code,

    SAFE_CAST(oi.quantity AS NUMERIC) AS quantity,
    SAFE_CAST(oi.sp AS NUMERIC) AS sp,

    SAFE_CAST(oi.sp AS NUMERIC)
      * SAFE_CAST(oi.quantity AS NUMERIC) AS gmv

  FROM `slikk-prod.slikkprodpublic.order_order` oo

  JOIN `slikk-prod.slikkprodpublic.order_orderitem` oi
    ON oo.id = oi.order_id

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = oi.product_id

  JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  JOIN `slikk-prod.slikksilver.product_tags` pt
    ON pt.product_id = pp.id

  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id

  LEFT JOIN `slikk-prod.slikkprodpublic.store_company` sc
    ON sc.id = pp.company_id

  CROSS JOIN date_range d

  WHERE
    oo.status NOT IN ('OPEN', 'FAILED')
    AND oo.delivery_type != 'EXCHANGE'
    AND DATE(oo.create_date, 'Asia/Kolkata')
      BETWEEN d.start_date AND d.end_date
),

sales_sku AS (
  SELECT
    division,
    gender,
    brand,
    style_code,
    sku,
    company_code,

    SUM(quantity) AS sales_qty_90d,
    SUM(gmv) AS sales_gmv_90d

  FROM sales_base
  GROUP BY
    division,
    gender,
    brand,
    style_code,
    sku,
    company_code
),

-- =========================================================
-- PART 3: JOIN SKU SALES WITH SKU DRR
-- =========================================================

sku_combined AS (
  SELECT
    s.division,
    s.gender,
    s.brand,
    s.style_code,
    s.sku,
    s.company_code,

    s.sales_qty_90d,
    s.sales_gmv_90d,

    COALESCE(d.drr_30d, 0) AS drr_30d,
    COALESCE(d.drr_60d, 0) AS drr_60d,
    COALESCE(d.drr_90d, 0) AS drr_90d

  FROM sales_sku s
  LEFT JOIN sku_drr_final d
    ON s.sku = d.sku
    AND LOWER(s.company_code) = LOWER(d.company_code)
),

-- =========================================================
-- PART 4: SALES STYLE-LEVEL AGGREGATION
-- =========================================================

style_level AS (
  SELECT
    UPPER(TRIM(division)) AS division,
    gender,
    brand,
    style_code,

    SUM(sales_qty_90d) AS sales_qty_90d,
    ROUND(SUM(sales_gmv_90d), 2) AS sales_gmv_90d,

    ROUND(SUM(drr_30d), 2) AS total_drr_30d,
    ROUND(SUM(drr_60d), 2) AS total_drr_60d,
    ROUND(SUM(drr_90d), 2) AS total_drr_90d

  FROM sku_combined
  GROUP BY
    division,
    gender,
    brand,
    style_code
),

-- =========================================================
-- PART 5: INVENTORY STYLE POPULATION
-- =========================================================

inventory_styles AS (
  SELECT DISTINCT
    UPPER(TRIM(nt.division)) AS division,
    COALESCE(pb.name, 'NA') AS brand,
    nt.gender AS gender,
    pp.variant_id AS style_code

  FROM `slikk-prod.slikkprodpublic.product_inventory` pi

  JOIN `slikk-prod.slikkprodpublic.store_store` ss
    ON pi.store_id = ss.id

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = pi.product_id

  JOIN `slikk-prod.slikkprodpublic.store_company` sc
    ON pp.company_id = sc.id

  JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  JOIN `slikk-prod.slikksilver.product_tags` pt
    ON pt.product_id = pi.product_id

  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id

  WHERE
    pp.variant_id IS NOT NULL
),

-- =========================================================
-- PART 6: COMBINE SALES + INVENTORY STYLE POPULATION
-- =========================================================

style_level_combined AS (

  SELECT
    UPPER(TRIM(division)) AS division,
    gender,
    brand,
    style_code,

    sales_qty_90d,
    sales_gmv_90d,

    total_drr_30d,
    total_drr_60d,
    total_drr_90d

  FROM style_level

  UNION ALL

  SELECT
    UPPER(TRIM(i.division)) AS division,
    i.gender,
    i.brand,
    i.style_code,

    0 AS sales_qty_90d,
    0 AS sales_gmv_90d,

    0 AS total_drr_30d,
    0 AS total_drr_60d,
    0 AS total_drr_90d

  FROM inventory_styles i

  LEFT JOIN style_level s
    ON UPPER(TRIM(s.division)) = UPPER(TRIM(i.division))
    AND s.gender = i.gender
    AND s.brand = i.brand
    AND s.style_code = i.style_code

  WHERE s.style_code IS NULL
),

-- =========================================================
-- PART 7: DRR AND GMV BASE
-- =========================================================

grading_base AS (
  SELECT
    *,

    GREATEST(
      total_drr_30d,
      total_drr_60d,
      total_drr_90d
    ) AS grading_drr,

    COALESCE(sales_gmv_90d, 0) AS grading_gmv

  FROM style_level_combined
),

-- =========================================================
-- PART 8: FOUR CUMULATIVE CONTRIBUTIONS
-- =========================================================

grading_running AS (
  SELECT
    *,

    SAFE_DIVIDE(
      SUM(grading_drr) OVER (
        PARTITION BY division
        ORDER BY
          grading_drr DESC,
          gender,
          brand,
          style_code
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ),
      SUM(grading_drr) OVER (
        PARTITION BY division
      )
    ) AS division_drr_cumulative_contribution,

    SAFE_DIVIDE(
      SUM(grading_drr) OVER (
        ORDER BY
          grading_drr DESC,
          division,
          gender,
          brand,
          style_code
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ),
      SUM(grading_drr) OVER ()
    ) AS overall_drr_cumulative_contribution,

    SAFE_DIVIDE(
      SUM(grading_gmv) OVER (
        PARTITION BY division
        ORDER BY
          grading_gmv DESC,
          gender,
          brand,
          style_code
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ),
      SUM(grading_gmv) OVER (
        PARTITION BY division
      )
    ) AS division_gmv_cumulative_contribution,

    SAFE_DIVIDE(
      SUM(grading_gmv) OVER (
        ORDER BY
          grading_gmv DESC,
          division,
          gender,
          brand,
          style_code
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ),
      SUM(grading_gmv) OVER ()
    ) AS overall_gmv_cumulative_contribution

  FROM grading_base
),

-- =========================================================
-- PART 9: FOUR GRADE ASSIGNMENTS
-- =========================================================

grade_output AS (
  SELECT
    *,

    CASE
      WHEN COALESCE(division_drr_cumulative_contribution, 0) <= 0.20 THEN 'A'
      WHEN division_drr_cumulative_contribution <= 0.40 THEN 'B'
      WHEN division_drr_cumulative_contribution <= 0.60 THEN 'C'
      WHEN division_drr_cumulative_contribution <= 0.80 THEN 'D'
      ELSE 'E'
    END AS division_drr_grade,

    CASE
      WHEN COALESCE(overall_drr_cumulative_contribution, 0) <= 0.20 THEN 'A'
      WHEN overall_drr_cumulative_contribution <= 0.40 THEN 'B'
      WHEN overall_drr_cumulative_contribution <= 0.60 THEN 'C'
      WHEN overall_drr_cumulative_contribution <= 0.80 THEN 'D'
      ELSE 'E'
    END AS overall_drr_grade,

    CASE
      WHEN COALESCE(division_gmv_cumulative_contribution, 0) <= 0.20 THEN 'A'
      WHEN division_gmv_cumulative_contribution <= 0.40 THEN 'B'
      WHEN division_gmv_cumulative_contribution <= 0.60 THEN 'C'
      WHEN division_gmv_cumulative_contribution <= 0.80 THEN 'D'
      ELSE 'E'
    END AS division_gmv_grade,

    CASE
      WHEN COALESCE(overall_gmv_cumulative_contribution, 0) <= 0.20 THEN 'A'
      WHEN overall_gmv_cumulative_contribution <= 0.40 THEN 'B'
      WHEN overall_gmv_cumulative_contribution <= 0.60 THEN 'C'
      WHEN overall_gmv_cumulative_contribution <= 0.80 THEN 'D'
      ELSE 'E'
    END AS overall_gmv_grade

  FROM grading_running
),

-- =========================================================
-- PART 10: FINAL GRADE = BEST OF ALL FOUR GRADES
-- =========================================================

final_output AS (
  SELECT
    *,

    CASE
      WHEN division IS NULL THEN
        LEAST(
          overall_drr_grade,
          overall_gmv_grade
        )
      ELSE
        LEAST(
          division_drr_grade,
          overall_drr_grade,
          division_gmv_grade,
          overall_gmv_grade
        )
    END AS final_grade

  FROM grade_output
),

-- =========================================================
-- PART 11: PIVOTAL - PRODUCT TAGS AND GENDER NORMALIZATION
-- =========================================================

pivotal_tags AS (
  SELECT
    product_id,

    MAX(UPPER(TRIM(division))) AS division,

    MAX(
      CASE
        WHEN UPPER(TRIM(gender)) IN ('MEN', 'MENS') THEN 'MEN'
        WHEN UPPER(TRIM(gender)) IN ('WOMEN', 'WOMENS') THEN 'WOMEN'
        WHEN UPPER(TRIM(gender)) IN ('UNISEX', 'UNSIEX') THEN 'UNISEX'
        ELSE UPPER(TRIM(gender))
      END
    ) AS gender

  FROM `slikk-prod.slikkanalytics.silver_new_product_tags`
  GROUP BY product_id
),

-- =========================================================
-- PART 12: ALL SKIDs - NO INVENTORY FILTER
-- =========================================================

pivotal_product_base AS (
  SELECT
    pt.division,
    pt.gender,

    COALESCE(pb.name, 'NA') AS brand,

    pp.variant_id AS style_code,
    pp.id AS skid,
    pp.sku AS sku,

    UPPER(
      TRIM(
        COALESCE(NULLIF(TRIM(CAST(pp.size AS STRING)), ''), 'FREE SIZE')
      )
    ) AS size

  FROM `slikk-prod.slikkprodpublic.product_product` pp

  JOIN pivotal_tags pt
    ON pt.product_id = pp.id

  LEFT JOIN `slikk-prod.slikkprodpublic.product_brand` pb
    ON pb.id = pp.brand_id

  WHERE
    pp.variant_id IS NOT NULL
    AND pt.division IN ('APPAREL', 'ETHNIC', 'FOOTWEAR')
),

-- =========================================================
-- PART 13: ALL-TIME FULFILLED QUANTITY BY SKID
-- =========================================================

pivotal_skid_sales AS (
  SELECT
    oi.product_id AS skid,

    SUM(
      COALESCE(SAFE_CAST(oi.fulfilled_quantity AS NUMERIC), 0)
    ) AS all_time_fulfilled_qty

  FROM `slikk-prod.slikkprodpublic.order_orderitem` oi

  JOIN `slikk-prod.slikkprodpublic.order_order` oo
    ON oo.id = oi.order_id

  WHERE
    oo.status NOT IN ('OPEN', 'FAILED')
    AND oo.delivery_type != 'EXCHANGE'

  GROUP BY oi.product_id
),

pivotal_product_sales AS (
  SELECT
    p.division,
    p.gender,
    p.brand,
    p.style_code,
    p.skid,
    p.sku,
    p.size,

    COALESCE(s.all_time_fulfilled_qty, 0) AS all_time_fulfilled_qty

  FROM pivotal_product_base p

  LEFT JOIN pivotal_skid_sales s
    ON s.skid = p.skid
),

-- =========================================================
-- PART 14: IDENTIFY PREDEFINED ANCHOR SIZES
-- =========================================================

pivotal_anchor_flags AS (
  SELECT
    *,

    CASE
      -- APPAREL / ETHNIC: MEN AND UNISEX
      WHEN division IN ('APPAREL', 'ETHNIC')
        AND gender IN ('MEN', 'UNISEX')
        AND size IN (
          'FREE SIZE', 'ONE SIZE',
          'M', 'L', 'XL',
          '32', '34', '36'
        )
      THEN 1

      -- APPAREL / ETHNIC: WOMEN
      WHEN division IN ('APPAREL', 'ETHNIC')
        AND gender = 'WOMEN'
        AND size IN (
          'FREE SIZE', 'ONE SIZE',
          'S', 'M', 'L',
          '28', '30', '32'
        )
      THEN 1

      -- FOOTWEAR: MEN AND UNISEX
      WHEN division = 'FOOTWEAR'
        AND gender IN ('MEN', 'UNISEX')
        AND size IN (
          'FREE SIZE', 'ONE SIZE',
          '7', '8', '9',
          '41', '42', '43'
        )
      THEN 1

      -- FOOTWEAR: WOMEN
      WHEN division = 'FOOTWEAR'
        AND gender = 'WOMEN'
        AND size IN (
          'FREE SIZE', 'ONE SIZE',
          '4', '5', '6',
          '37', '38', '39'
        )
      THEN 1

      ELSE 0
    END AS is_anchor_size

  FROM pivotal_product_sales
),

-- =========================================================
-- PART 15: CHECK WHETHER STYLE HAS ANY ANCHOR SIZE
-- =========================================================

pivotal_style_anchor AS (
  SELECT
    *,

    MAX(is_anchor_size) OVER (
      PARTITION BY
        division,
        gender,
        style_code
    ) AS style_has_anchor_size

  FROM pivotal_anchor_flags
),

-- =========================================================
-- PART 16: SALES-BASED FALLBACK RANKING
-- Only used when style has no anchor size.
-- Cumulative quantity <= 60% of style total.
-- Partition remains style_code only.
-- =========================================================

pivotal_fallback_ranked AS (
  SELECT
    *,

    SUM(all_time_fulfilled_qty) OVER (
      PARTITION BY style_code
      ORDER BY
        all_time_fulfilled_qty DESC,
        sku,
        skid
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cumulative_fulfilled_qty,

    SUM(all_time_fulfilled_qty) OVER (
      PARTITION BY style_code
    ) AS style_total_fulfilled_qty

  FROM pivotal_style_anchor
),

-- =========================================================
-- PART 17: FINAL SKID-LEVEL PIVOTAL CLASSIFICATION
-- =========================================================

pivotal_skid_classified AS (
  SELECT
    division,
    gender,
    brand,
    style_code,

    skid,
    sku,
    size,

    all_time_fulfilled_qty,
    is_anchor_size,
    style_has_anchor_size,
    cumulative_fulfilled_qty,
    style_total_fulfilled_qty,

    CASE
      -- If anchor size exists, only anchor-size SKIDs are pivotal
      WHEN style_has_anchor_size = 1
        AND is_anchor_size = 1
      THEN 'PIVOTAL'

      WHEN style_has_anchor_size = 1
        AND is_anchor_size = 0
      THEN 'NON_PIVOTAL'

      -- If no anchor size, use 60% fulfilled quantity fallback
      WHEN style_has_anchor_size = 0
        AND style_total_fulfilled_qty > 0
        AND cumulative_fulfilled_qty <=
            0.60 * style_total_fulfilled_qty
      THEN 'PIVOTAL'

      ELSE 'NON_PIVOTAL'
    END AS pivotal_status

  FROM pivotal_fallback_ranked
)
,
-- =========================================================
-- PART 18: INVENTORY CURRENT STOCK
-- =========================================================

inventory_current AS (
  SELECT
    UPPER(TRIM(nt.division)) AS division,
    pp.variant_id AS style_code,
    pp.sku,
    LOWER(sc.code) AS company_code,

    SUM(IF(ss.code IN (
      'slikk101', 'slikk103', 'slikk104',
      'slikk105', 'slikk106', 'Slikk107'
    ), pi.quantity, 0)) AS dark_store_current,

    SUM(IF(ss.code IN (
      'slikk102', 'DHLBLR101'
    ), pi.quantity, 0)) AS motherhub_current

  FROM `slikk-prod.slikkprodpublic.product_inventory` pi
  JOIN `slikk-prod.slikkprodpublic.store_store` ss
    ON pi.store_id = ss.id
  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = pi.product_id
  JOIN `slikk-prod.slikkprodpublic.store_company` sc
    ON sc.id = pp.company_id
  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id

  WHERE pp.variant_id IS NOT NULL

  GROUP BY 1, 2, 3, 4
),

-- =========================================================
-- PART 19: QUALITY CHECK AGGREGATION FOR IN-TRANSIT
-- =========================================================

inventory_qc AS (
  SELECT
    gdn.indent_note_id,
    qc.sku,
    qc.company_id,
    grn.store_id,
    SUM(qc.qc_passed) AS qc_passed

  FROM `slikk-prod.slikkprodpublic.product_goodsqualitycheck` qc
  JOIN `slikk-prod.slikkprodpublic.product_goodsreceivednote` grn
    ON qc.grn_id = grn.id
  JOIN `slikk-prod.slikkprodpublic.product_goodsshipment` sh
    ON grn.shipment_id = COALESCE(sh.parent_shipment_id, sh.id)
  JOIN `slikk-prod.slikkprodpublic.product_goodsdispatchnote` gdn
    ON sh.gdn_id = gdn.id

  GROUP BY 1, 2, 3, 4
),

-- =========================================================
-- PART 20: IN-TRANSIT BY SKU AND COMPANY
-- =========================================================

inventory_transit AS (
  SELECT
    UPPER(TRIM(nt.division)) AS division,
    pp.variant_id AS style_code,
    i.sku,
    LOWER(sc.code) AS company_code,

    SUM(
      CASE
        WHEN target_store.code IN (
          'slikk101', 'slikk103', 'slikk104',
          'slikk105', 'slikk106', 'Slikk107'
        )
        THEN
          CASE
            WHEN LOWER(inote.status) = 'fulfilled' THEN 0
            ELSE GREATEST(i.synced_quantity - i.quantity_accepted, 0)
          END
          +
          CASE
            WHEN DATE(inote.create_date + INTERVAL 330 MINUTE)
              >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 2 MONTH)
            THEN GREATEST(i.quantity_accepted - COALESCE(qc.qc_passed, 0), 0)
            ELSE 0
          END
        ELSE 0
      END
    ) AS dark_store_transit,

    SUM(
      CASE
        WHEN target_store.code IN ('slikk102', 'DHLBLR101')
        THEN
          CASE
            WHEN LOWER(inote.status) = 'fulfilled' THEN 0
            ELSE GREATEST(i.synced_quantity - i.quantity_accepted, 0)
          END
          +
          CASE
            WHEN DATE(inote.create_date + INTERVAL 330 MINUTE)
              >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 2 MONTH)
            THEN GREATEST(i.quantity_accepted - COALESCE(qc.qc_passed, 0), 0)
            ELSE 0
          END
        ELSE 0
      END
    ) AS motherhub_transit

  FROM `slikk-prod.slikkprodpublic.product_intentnoteitem` i
  JOIN `slikk-prod.slikkprodpublic.product_intentnote` inote
    ON i.intent_note_id = inote.id
  JOIN `slikk-prod.slikkprodpublic.store_company` sc
    ON i.company_id = sc.id
  JOIN `slikk-prod.slikkprodpublic.store_store` target_store
    ON target_store.id = inote.target_store_id
  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.sku = i.sku
    AND LOWER(CAST(pp.company_id AS STRING)) = LOWER(CAST(i.company_id AS STRING))
  LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
    ON nt.product_id = pp.id
  LEFT JOIN inventory_qc qc
    ON qc.indent_note_id = i.intent_note_id
    AND qc.sku = i.sku
    AND qc.company_id = i.company_id
    AND qc.store_id = inote.target_store_id

  WHERE LOWER(inote.status) NOT IN ('rejected', 'draft')
    AND pp.variant_id IS NOT NULL

  GROUP BY 1, 2, 3, 4
),

-- =========================================================
-- PART 21: COMBINE CURRENT + IN-TRANSIT
-- =========================================================

inventory_combined AS (
  SELECT
    COALESCE(c.division, t.division) AS division,
    COALESCE(c.style_code, t.style_code) AS style_code,
    COALESCE(c.sku, t.sku) AS sku,
    COALESCE(c.company_code, t.company_code) AS company_code,

    COALESCE(c.dark_store_current, 0) AS dark_store_current,
    COALESCE(c.motherhub_current, 0) AS motherhub_current,

    COALESCE(t.dark_store_transit, 0) AS dark_store_transit,
    COALESCE(t.motherhub_transit, 0) AS motherhub_transit

  FROM inventory_current c
  FULL OUTER JOIN inventory_transit t
    ON c.sku = t.sku
    AND LOWER(c.company_code) = LOWER(t.company_code)
),

-- =========================================================
-- PART 22: INVENTORY OUTPUT AT REQUIRED GRAIN
-- =========================================================

inventory_output AS (
  SELECT
    division,
    style_code,

    CASE
      WHEN division IN ('APPAREL', 'ETHNIC', 'FOOTWEAR')
      THEN sku
      ELSE NULL
    END AS sku,

    SUM(dark_store_current) AS dark_store_total_current_inventory,
    SUM(motherhub_current) AS motherhub_total_current_inventory,

    SUM(dark_store_current + motherhub_current)
      AS total_current_inventory,

    SUM(dark_store_current + dark_store_transit)
      AS dark_store_total_effective_inventory,

    SUM(motherhub_current + motherhub_transit)
      AS motherhub_total_effective_inventory,

    SUM(
      dark_store_current
      + motherhub_current
      + dark_store_transit
      + motherhub_transit
    ) AS total_effective_inventory

  FROM inventory_combined

  GROUP BY
    division,
    style_code,
    CASE
      WHEN division IN ('APPAREL', 'ETHNIC', 'FOOTWEAR')
      THEN sku
      ELSE NULL
    END
)
-- =========================================================
-- PART 23: FINAL GRADING + INVENTORY OUTPUT
-- =========================================================

-- =========================================================
-- PART 23: FINAL GRADING + INVENTORY OUTPUT
-- =========================================================

SELECT
  f.division,
  f.gender,
  f.brand,
  f.style_code,

  p.sku,

  CASE
    WHEN UPPER(TRIM(f.division))
      IN ('APPAREL', 'ETHNIC', 'FOOTWEAR')
    THEN COALESCE(p.pivotal_status, 'NOT MATCHED')
    ELSE NULL
  END AS pivotal_status,

  f.final_grade,

  COALESCE(inv.dark_store_total_current_inventory, 0)
    AS dark_store_total_current_inventory,

  COALESCE(inv.motherhub_total_current_inventory, 0)
    AS motherhub_total_current_inventory,

  COALESCE(inv.total_current_inventory, 0)
    AS total_current_inventory,

  COALESCE(inv.dark_store_total_effective_inventory, 0)
    AS dark_store_total_effective_inventory,

  COALESCE(inv.motherhub_total_effective_inventory, 0)
    AS motherhub_total_effective_inventory,

  COALESCE(inv.total_effective_inventory, 0)
    AS total_effective_inventory

FROM final_output f

LEFT JOIN pivotal_skid_classified p
  ON UPPER(TRIM(f.division)) = p.division

  AND (
    CASE
      WHEN UPPER(TRIM(f.gender)) IN ('MEN', 'MENS') THEN 'MEN'
      WHEN UPPER(TRIM(f.gender)) IN ('WOMEN', 'WOMENS') THEN 'WOMEN'
      WHEN UPPER(TRIM(f.gender)) IN ('UNISEX', 'UNSIEX') THEN 'UNISEX'
      ELSE UPPER(TRIM(f.gender))
    END
  ) IS NOT DISTINCT FROM p.gender

  AND UPPER(TRIM(COALESCE(f.brand, 'NA'))) =
      UPPER(TRIM(COALESCE(p.brand, 'NA')))

  AND f.style_code = p.style_code

LEFT JOIN inventory_output inv
  ON UPPER(TRIM(f.division)) = UPPER(TRIM(inv.division))

  AND (
    (
      UPPER(TRIM(f.division))
        IN ('APPAREL', 'ETHNIC', 'FOOTWEAR')
      AND p.sku = inv.sku
    )
    OR
    (
      UPPER(TRIM(f.division))
        NOT IN ('APPAREL', 'ETHNIC', 'FOOTWEAR')
      AND f.style_code = inv.style_code
    )
  )

ORDER BY
  f.division,
  f.grading_drr DESC,
  f.gender,
  f.brand,
  f.style_code,
  p.sku,
  p.skid;
